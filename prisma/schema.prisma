// PharmaBridge — regulated pharmaceutical surplus marketplace
// Source of truth for the data model. See docs/architecture/C-domain-model-and-schema.md
// PostgreSQL 16. UUIDv7 ids. Decimal for all money. Append-only audit (DB trigger in migration).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum PlatformRole {
  PLATFORM_ADMIN
  COMPLIANCE_OFFICER
  REGULATORY_ANALYST
}

enum OrgKind {
  SELLER
  BUYER
  HYBRID
  LOGISTICS
}

enum OrgStatus {
  DRAFT
  PENDING_KYB
  VERIFIED
  REJECTED
  SUSPENDED
}

enum KybStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

enum SanctionsResult {
  NOT_SCREENED
  CLEAR
  REVIEW
  BLOCKED
}

enum OrgRole {
  OWNER
  ADMIN
  COMMERCIAL
  INVENTORY
  COMPLIANCE
  FINANCE
  VIEWER
}

enum MemberStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum LicenseType {
  WDA
  GDP
  GMP
  MANUFACTURING
  IMPORT
  WHOLESALE
  HOSPITAL
  PHARMACY
  OTHER
}

enum LicenseStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
  SUSPENDED
}

enum CountryTradeStatus {
  NOT_TRADE_ENABLED
  RESEARCH_IN_PROGRESS
  TRADE_ENABLED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  VERIFIED
  SUSPENDED
}

enum RxStatus {
  RX
  OTC
  UNKNOWN
}

enum ControlledStatus {
  NONE
  NARCOTIC
  PSYCHOTROPIC
  OTHER_CONTROLLED
  UNKNOWN
}

enum IdentifierType {
  GTIN
  PZN
  NATIONAL_CODE
  EU_CODE
  OTHER
}

enum RegistrationStatus {
  UNKNOWN
  REGISTERED
  NOT_REGISTERED
  PENDING
  EXEMPT_POSSIBLE
}

enum QualityStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum BatchRecallStatus {
  NONE
  SUSPECTED
  RECALLED
}

enum QuarantineStatus {
  NONE
  QUARANTINED
  RELEASED
}

enum ListingType {
  SURPLUS
  SHORT_DATED
}

enum ListingStatus {
  DRAFT
  PENDING_COMPLIANCE
  ACTIVE
  PAUSED
  SOLD_OUT
  WITHDRAWN
  BLOCKED
}

enum ListingVisibility {
  PUBLIC_VERIFIED
  COUNTRY_RESTRICTED
  INVITE_ONLY
  PRIVATE
}

enum EligibilityVerdict {
  ELIGIBLE
  CONDITIONALLY_ELIGIBLE
  INELIGIBLE
  HUMAN_REVIEW_REQUIRED
  INSUFFICIENT_DATA
}

enum DemandStatus {
  ACTIVE
  PAUSED
  FULFILLED
  EXPIRED
  CANCELLED
}

enum MatchStatus {
  PROPOSED
  VIEWED
  DISMISSED
  CONVERTED
}

enum NegotiationStatus {
  OPEN
  CONCLUDED
  CANCELLED
}

enum OfferDirection {
  BUYER_TO_SELLER
  SELLER_TO_BUYER
}

enum OfferStatus {
  SUBMITTED
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum TransactionState {
  DRAFT
  LISTED
  MATCHED
  BUYER_INTEREST
  NEGOTIATION
  OFFER_SUBMITTED
  OFFER_ACCEPTED
  COMPLIANCE_REVIEW
  DOCUMENTS_REQUIRED
  IMPORT_PERMIT_PENDING
  READY_FOR_PAYMENT
  PAYMENT_AUTHORIZED
  READY_FOR_PICKUP
  IN_TRANSIT
  CUSTOMS
  DELIVERED
  BUYER_ACCEPTED
  SETTLED
  CANCELLED
  REJECTED
  QUARANTINED
  RECALL
  DISPUTE
}

enum ActorType {
  USER
  SYSTEM
  COMPLIANCE
}

enum ReviewType {
  KYB
  LICENSE
  PRODUCT
  LISTING
  TRANSACTION
  COUNTRY_RULE
}

enum ReviewStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  NEEDS_DOCUMENTS
}

enum PermitStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
  EXPIRED
}

enum RuleType {
  SHELF_LIFE
  PRODUCT_REGISTRATION
  IMPORT_LICENSE
  LABELING
  SERIALIZATION
  CONTROLLED
  CUSTOMS
  OTHER
}

enum RuleVersionStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  OUTDATED
  CONFLICTING_SOURCES
  REQUIRES_LOCAL_COUNSEL
  SUSPENDED
  DEMO
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
  UNVERIFIED
}

enum DocumentStatus {
  UPLOADED
  VERIFIED
  REJECTED
}

enum ShipmentStatus {
  PLANNED
  BOOKED
  PICKED_UP
  IN_TRANSIT
  CUSTOMS
  DELIVERED
  EXCEPTION
  CANCELLED
}

enum TemperatureMode {
  AMBIENT
  COLD_2_8
  FROZEN
  CONTROLLED_ROOM
}

enum PaymentState {
  PENDING
  AUTHORIZED
  HELD
  PAID
  RELEASED
  REFUNDED
  FAILED
  DISPUTED
}

enum InvoiceType {
  BUYER_INVOICE
  SELLER_SELF_BILL
  COMMISSION
}

enum PayoutState {
  PENDING
  EXECUTED
  FAILED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum SanctionsSubjectType {
  ORGANIZATION
  USER
  BANK
  COUNTRY
  ROUTE
}

enum RecallCaseStatus {
  ACTIVE
  RESOLVED
}

enum AffectedBatchStatus {
  QUARANTINED
  RETURNED
  DESTROYED
}

enum ShortageSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  UNKNOWN
}

// ─────────────────────────── Identity & Access ───────────────────────────

model User {
  id            String        @id @default(uuid(7)) @db.Uuid
  email         String        @unique
  passwordHash  String
  firstName     String
  lastName      String
  locale        String        @default("de")
  platformRole  PlatformRole?
  status        UserStatus    @default(ACTIVE)
  mfaEnabled    Boolean       @default(false)
  mfaSecret     String?
  lastLoginAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  sessions             Session[]
  memberships          OrganizationMember[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  licensesVerified     License[]                @relation("LicenseVerifier")
  reviewsAssigned      ComplianceReview[]       @relation("ReviewAssignee")
  reviewsDecided       ComplianceReview[]       @relation("ReviewDecider")
  ruleVersionsCreated  RegulatoryRuleVersion[]  @relation("RuleVersionCreator")
  ruleVersionsVerified RegulatoryRuleVersion[]  @relation("RuleVersionVerifier")
  documentsUploaded    Document[]
  sanctionsChecks      SanctionsCheck[]
  dealMessages         DealMessage[]

  @@index([platformRole])
}

model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  ip        String?
  userAgent String?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Organization {
  id               String          @id @default(uuid(7)) @db.Uuid
  kind             OrgKind
  legalName        String
  tradingName      String?
  registrationNumber String?
  vatNumber        String?
  countryId        String
  country          Country         @relation(fields: [countryId], references: [id])
  addressLine1     String?
  addressLine2     String?
  city             String?
  postalCode       String?
  website          String?
  contactEmail     String?
  contactPhone     String?
  authorizedRepresentative String?
  bankInfo         Json?
  beneficialOwners Json?
  status           OrgStatus       @default(DRAFT)
  kybStatus        KybStatus       @default(NOT_STARTED)
  sanctionsStatus  SanctionsResult @default(NOT_SCREENED)
  isDemo           Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  members          OrganizationMember[]
  licenses         License[]
  warehouses       Warehouse[]
  batches          Batch[]
  listings         Listing[]
  demands          BuyerDemand[]
  productsProposed Product[]
  documents        Document[]
  reviews          ComplianceReview[]
  permits          ImportPermit[]
  payouts          Payout[]
  notifications    Notification[]
  matchesAsSeller  Match[]              @relation("MatchSeller")
  matchesAsBuyer   Match[]              @relation("MatchBuyer")
  negotiationsAsSeller Negotiation[]    @relation("NegotiationSeller")
  negotiationsAsBuyer  Negotiation[]    @relation("NegotiationBuyer")
  offersMade       Offer[]
  salesTransactions Transaction[]       @relation("TransactionSeller")
  purchaseTransactions Transaction[]    @relation("TransactionBuyer")
  dealMessages     DealMessage[]

  @@index([countryId])
  @@index([status])
  @@index([kind])
}

model OrganizationMember {
  id        String       @id @default(uuid(7)) @db.Uuid
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId     String       @db.Uuid
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role      OrgRole
  status    MemberStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, orgId])
  @@index([orgId])
}

model License {
  id               String        @id @default(uuid(7)) @db.Uuid
  orgId            String        @db.Uuid
  org              Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  type             LicenseType
  number           String
  issuingAuthority String
  countryId        String
  country          Country       @relation(fields: [countryId], references: [id])
  issueDate        DateTime?
  expiryDate       DateTime
  status           LicenseStatus @default(PENDING_REVIEW)
  verifiedById     String?       @db.Uuid
  verifiedBy       User?         @relation("LicenseVerifier", fields: [verifiedById], references: [id])
  verifiedAt       DateTime?
  notes            String?
  isDemo           Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  documents Document[]
  reviews   ComplianceReview[]

  @@index([orgId])
  @@index([expiryDate])
  @@index([status])
}

model Warehouse {
  id                 String       @id @default(uuid(7)) @db.Uuid
  orgId              String       @db.Uuid
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name               String
  addressLine1       String?
  city               String?
  postalCode         String?
  countryId          String
  country            Country      @relation(fields: [countryId], references: [id])
  capAmbient         Boolean      @default(true)
  capCold2to8        Boolean      @default(false)
  capFrozen          Boolean      @default(false)
  capControlledRoom  Boolean      @default(false)
  gdpCompliant       Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  batches   Batch[]
  shipments Shipment[]

  @@index([orgId])
}

// ─────────────────────────── Master data ───────────────────────────

model Country {
  id                    String             @id // ISO 3166-1 alpha-2 ("ZZ" = fictional demo country)
  nameEn                String
  nameDe                String
  nameAr                String
  region                String
  isEea                 Boolean            @default(false)
  isSupplyEnabled       Boolean            @default(false)
  isDestinationEnabled  Boolean            @default(false)
  tradeStatus           CountryTradeStatus @default(NOT_TRADE_ENABLED)
  shippingDays          Int?
  customsBufferDays     Int?
  operationalBufferDays Int?
  isDemo                Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  organizations    Organization[]
  warehouses       Warehouse[]
  licenses         License[]
  authorities      RegulatoryAuthority[]
  registrations    ProductCountryRegistration[]
  rules            RegulatoryRule[]
  sources          RegulatorySource[]
  readinessScores  CountryReadinessScore[]
  listingEligibilities ListingEligibility[]
  demands          BuyerDemand[]
  transactions     Transaction[]
  permits          ImportPermit[]
  shortageSignals  ShortageSignal[]
  documents        Document[]
  manufacturers    Manufacturer[]
  pricingReferences PricingReference[]
}

model RegulatoryAuthority {
  id        String   @id @default(uuid(7)) @db.Uuid
  countryId String
  country   Country  @relation(fields: [countryId], references: [id])
  name      String
  website   String?
  type      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
}

model Manufacturer {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String
  countryId String?
  country   Country?  @relation(fields: [countryId], references: [id])
  isDemo    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]
  recalls  Recall[]
}

model Product {
  id                      String           @id @default(uuid(7)) @db.Uuid
  inn                     String
  brandName               String?
  manufacturerId          String?          @db.Uuid
  manufacturer            Manufacturer?    @relation(fields: [manufacturerId], references: [id])
  mahName                 String?
  atcCode                 String?
  strengthValue           Decimal?         @db.Decimal(12, 4)
  strengthUnit            String?
  dosageForm              String
  routeOfAdministration   String?
  packSize                Int?
  packUnit                String?
  prescriptionStatus      RxStatus         @default(UNKNOWN)
  controlledStatus        ControlledStatus @default(UNKNOWN)
  coldChain               Boolean          @default(false)
  storageMinC             Decimal?         @db.Decimal(6, 2)
  storageMaxC             Decimal?         @db.Decimal(6, 2)
  hazardClass             String?
  serializationRequired   Boolean          @default(false)
  originalShelfLifeMonths Int?
  manufacturerCountryId   String?
  status                  ProductStatus    @default(DRAFT)
  proposedByOrgId         String?          @db.Uuid
  proposedByOrg           Organization?    @relation(fields: [proposedByOrgId], references: [id])
  isDemo                  Boolean          @default(false)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  deletedAt               DateTime?

  identifiers   ProductIdentifier[]
  registrations ProductCountryRegistration[]
  batches       Batch[]
  listings      Listing[]
  demands       BuyerDemand[]
  recalls       Recall[]
  documents     Document[]
  reviews       ComplianceReview[]
  pricingReferences PricingReference[]
  shortageSignals   ShortageSignal[]

  @@index([inn])
  @@index([atcCode])
  @@index([status])
}

model ProductIdentifier {
  id        String         @id @default(uuid(7)) @db.Uuid
  productId String         @db.Uuid
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      IdentifierType
  value     String
  countryId String?
  createdAt DateTime       @default(now())

  @@unique([type, value, countryId])
  @@index([productId])
}

model ProductCountryRegistration {
  id                 String             @id @default(uuid(7)) @db.Uuid
  productId          String             @db.Uuid
  product            Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  countryId          String
  country            Country            @relation(fields: [countryId], references: [id])
  status             RegistrationStatus @default(UNKNOWN)
  registrationNumber String?
  holder             String?
  sourceName         String?
  sourceUrl          String?
  verifiedAt         DateTime?
  verifiedById       String?            @db.Uuid
  notes              String?
  isDemo             Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([productId, countryId])
  @@index([countryId])
}

// ─────────────────────────── Inventory ───────────────────────────

model Batch {
  id                    String            @id @default(uuid(7)) @db.Uuid
  productId             String            @db.Uuid
  product               Product           @relation(fields: [productId], references: [id])
  sellerOrgId           String            @db.Uuid
  sellerOrg             Organization      @relation(fields: [sellerOrgId], references: [id])
  warehouseId           String            @db.Uuid
  warehouse             Warehouse         @relation(fields: [warehouseId], references: [id])
  lotNumber             String
  manufacturingDate     DateTime?
  expiryDate            DateTime
  originalShelfLifeDays Int?
  quantity              Int
  unit                  String            @default("pack")
  packQuantity          Int?
  temperatureMode       TemperatureMode   @default(AMBIENT)
  packagingLanguage     String?
  countrySpecificPackaging String?
  tamperEvidenceIntact  Boolean?
  storageHistoryNote    String?
  temperatureExcursion  Boolean           @default(false)
  serializationStatus   String?
  productCondition      String?
  packagingCondition    String?
  recallStatus          BatchRecallStatus @default(NONE)
  quarantineStatus      QuarantineStatus  @default(NONE)
  qualityStatus         QualityStatus     @default(UNVERIFIED)
  verifiedAt            DateTime?
  isDemo                Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  deletedAt             DateTime?

  position         InventoryPosition?
  listings         Listing[]
  documents        Document[]
  matches          Match[]
  transactions     Transaction[]
  transactionItems TransactionItem[]
  recallLinks      RecallAffectedBatch[]

  @@index([sellerOrgId])
  @@index([productId])
  @@index([expiryDate])
  @@index([recallStatus])
}

model InventoryPosition {
  id       String @id @default(uuid(7)) @db.Uuid
  batchId  String @unique @db.Uuid
  batch    Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  onHand   Int
  reserved Int    @default(0)
  sold     Int    @default(0)
  updatedAt DateTime @updatedAt
}

// ─────────────────────── Regulatory intelligence ───────────────────────

model RegulatoryRule {
  id               String   @id @default(uuid(7)) @db.Uuid
  countryId        String
  country          Country  @relation(fields: [countryId], references: [id])
  ruleType         RuleType
  productScope     String?  // optional scope note, e.g. "vaccines", ATC prefix
  currentVersionId String?  @unique @db.Uuid
  currentVersion   RegulatoryRuleVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  versions RegulatoryRuleVersion[] @relation("RuleVersions")

  @@unique([countryId, ruleType, productScope])
  @@index([countryId])
}

model RegulatoryRuleVersion {
  id                 String            @id @default(uuid(7)) @db.Uuid
  ruleId             String            @db.Uuid
  rule               RegulatoryRule    @relation("RuleVersions", fields: [ruleId], references: [id], onDelete: Cascade)
  version            Int
  payload            Json
  status             RuleVersionStatus @default(DRAFT)
  authorityName      String?
  sourceName         String?
  sourceUrl          String?
  publishedAt        DateTime?
  effectiveAt        DateTime?
  lastVerifiedAt     DateTime?
  verifiedById       String?           @db.Uuid
  verifiedBy         User?             @relation("RuleVersionVerifier", fields: [verifiedById], references: [id])
  confidence         ConfidenceLevel   @default(UNVERIFIED)
  notes              String?
  supersedesVersionId String?          @db.Uuid
  supersedesVersion  RegulatoryRuleVersion?  @relation("Supersedes", fields: [supersedesVersionId], references: [id])
  supersededBy       RegulatoryRuleVersion[] @relation("Supersedes")
  createdById        String?           @db.Uuid
  createdBy          User?             @relation("RuleVersionCreator", fields: [createdById], references: [id])
  createdAt          DateTime          @default(now())

  currentOfRule RegulatoryRule?    @relation("CurrentVersion")
  reviews       ComplianceReview[]

  @@unique([ruleId, version])
  @@index([status])
}

model RegulatorySource {
  id          String   @id @default(uuid(7)) @db.Uuid
  countryId   String
  country     Country  @relation(fields: [countryId], references: [id])
  title       String
  url         String
  retrievedAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([countryId])
}

model CountryReadinessScore {
  id         String   @id @default(uuid(7)) @db.Uuid
  countryId  String
  country    Country  @relation(fields: [countryId], references: [id])
  total      Int
  components Json
  version    Int      @default(1)
  computedAt DateTime @default(now())
  computedBy String?

  @@index([countryId])
}

model ShortageSignal {
  id                 String           @id @default(uuid(7)) @db.Uuid
  source             String
  sourceUrl          String?
  countryId          String
  country            Country          @relation(fields: [countryId], references: [id])
  productId          String?          @db.Uuid
  product            Product?         @relation(fields: [productId], references: [id])
  productFreeText    String?
  severity           ShortageSeverity @default(UNKNOWN)
  status             String           @default("REPORTED")
  reportedAt         DateTime
  expectedResolution DateTime?
  confidence         ConfidenceLevel  @default(UNVERIFIED)
  createdAt          DateTime         @default(now())

  @@index([countryId])
}

// ─────────────────────────── Marketplace ───────────────────────────

model Listing {
  id               String            @id @default(uuid(7)) @db.Uuid
  sellerOrgId      String            @db.Uuid
  sellerOrg        Organization      @relation(fields: [sellerOrgId], references: [id])
  batchId          String            @db.Uuid
  batch            Batch             @relation(fields: [batchId], references: [id])
  productId        String            @db.Uuid
  product          Product           @relation(fields: [productId], references: [id])
  listingType      ListingType
  quantityAvailable Int
  minOrderQuantity Int               @default(1)
  unitPrice        Decimal           @db.Decimal(18, 4)
  currency         String            @default("EUR")
  negotiable       Boolean           @default(true)
  incoterm         String?
  visibility       ListingVisibility @default(PUBLIC_VERIFIED)
  /** For visibility COUNTRY_RESTRICTED: destination countries allowed to see/buy. */
  restrictedToCountryIds String[]    @default([])
  anonymousSeller  Boolean           @default(false)
  status           ListingStatus     @default(DRAFT)
  complianceNote   String?
  publishedAt      DateTime?
  isDemo           Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  eligibilities ListingEligibility[]
  matches       Match[]
  negotiations  Negotiation[]
  transactions  Transaction[]
  reviews       ComplianceReview[]

  @@index([sellerOrgId])
  @@index([status])
  @@index([productId])
}

model ListingEligibility {
  id                       String             @id @default(uuid(7)) @db.Uuid
  listingId                String             @db.Uuid
  listing                  Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  countryId                String
  country                  Country            @relation(fields: [countryId], references: [id])
  verdict                  EligibilityVerdict
  reasons                  Json
  requiredDocuments        Json?
  requiredPermits          Json?
  projectedArrivalDate     DateTime?
  arrivalShelfLifeDays     Int?
  arrivalShelfLifePercent  Decimal?           @db.Decimal(6, 2)
  requiresHumanReview      Boolean            @default(false)
  engineVersion            String
  ruleVersionIds           Json?
  evaluatedAt              DateTime           @default(now())

  @@unique([listingId, countryId])
  @@index([countryId, verdict])
}

model BuyerDemand {
  id                          String       @id @default(uuid(7)) @db.Uuid
  buyerOrgId                  String       @db.Uuid
  buyerOrg                    Organization @relation(fields: [buyerOrgId], references: [id])
  productId                   String?      @db.Uuid
  product                     Product?     @relation(fields: [productId], references: [id])
  productFreeText             String?
  strengthText                String?
  dosageFormText              String?
  quantity                    Int
  unit                        String       @default("pack")
  destinationCountryId        String
  destinationCountry          Country      @relation(fields: [destinationCountryId], references: [id])
  requiredBy                  DateTime?
  maxUnitPrice                Decimal?     @db.Decimal(18, 4)
  currency                    String       @default("EUR")
  minRemainingShelfLifeMonths Int?
  coldChainRequired           Boolean      @default(false)
  monthlyConsumptionUnits     Int?
  status                      DemandStatus @default(ACTIVE)
  visibility                  ListingVisibility @default(PUBLIC_VERIFIED)
  isDemo                      Boolean      @default(false)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  matches      Match[]
  negotiations Negotiation[]

  @@index([buyerOrgId])
  @@index([destinationCountryId])
  @@index([status])
}

model Match {
  id                  String       @id @default(uuid(7)) @db.Uuid
  listingId           String?      @db.Uuid
  listing             Listing?     @relation(fields: [listingId], references: [id])
  demandId            String?      @db.Uuid
  demand              BuyerDemand? @relation(fields: [demandId], references: [id])
  batchId             String       @db.Uuid
  batch               Batch        @relation(fields: [batchId], references: [id])
  sellerOrgId         String       @db.Uuid
  sellerOrg           Organization @relation("MatchSeller", fields: [sellerOrgId], references: [id])
  buyerOrgId          String       @db.Uuid
  buyerOrg            Organization @relation("MatchBuyer", fields: [buyerOrgId], references: [id])
  score               Int
  scoreBreakdown      Json
  eligibilitySnapshot Json
  status              MatchStatus  @default(PROPOSED)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([listingId, demandId])
  @@index([sellerOrgId])
  @@index([buyerOrgId])
}

model Negotiation {
  id          String            @id @default(uuid(7)) @db.Uuid
  listingId   String?           @db.Uuid
  listing     Listing?          @relation(fields: [listingId], references: [id])
  demandId    String?           @db.Uuid
  demand      BuyerDemand?      @relation(fields: [demandId], references: [id])
  sellerOrgId String            @db.Uuid
  sellerOrg   Organization      @relation("NegotiationSeller", fields: [sellerOrgId], references: [id])
  buyerOrgId  String            @db.Uuid
  buyerOrg    Organization      @relation("NegotiationBuyer", fields: [buyerOrgId], references: [id])
  status      NegotiationStatus @default(OPEN)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  offers       Offer[]
  transactions Transaction[]

  @@index([sellerOrgId])
  @@index([buyerOrgId])
}

model Offer {
  id                    String         @id @default(uuid(7)) @db.Uuid
  negotiationId         String         @db.Uuid
  negotiation           Negotiation    @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  byOrgId               String         @db.Uuid
  byOrg                 Organization   @relation(fields: [byOrgId], references: [id])
  direction             OfferDirection
  quantity              Int
  unitPrice             Decimal        @db.Decimal(18, 4)
  currency              String         @default("EUR")
  incoterm              String?
  requestedDeliveryDate DateTime?
  conditions            String?
  status                OfferStatus    @default(SUBMITTED)
  parentOfferId         String?        @db.Uuid
  parentOffer           Offer?         @relation("OfferCounter", fields: [parentOfferId], references: [id])
  counterOffers         Offer[]        @relation("OfferCounter")
  expiresAt             DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([negotiationId])
}

// ─────────────────────────── Transactions ───────────────────────────

model Transaction {
  id                   String           @id @default(uuid(7)) @db.Uuid
  negotiationId        String?          @db.Uuid
  negotiation          Negotiation?     @relation(fields: [negotiationId], references: [id])
  listingId            String?          @db.Uuid
  listing              Listing?         @relation(fields: [listingId], references: [id])
  batchId              String           @db.Uuid
  batch                Batch            @relation(fields: [batchId], references: [id])
  sellerOrgId          String           @db.Uuid
  sellerOrg            Organization     @relation("TransactionSeller", fields: [sellerOrgId], references: [id])
  buyerOrgId           String           @db.Uuid
  buyerOrg             Organization     @relation("TransactionBuyer", fields: [buyerOrgId], references: [id])
  destinationCountryId String
  destinationCountry   Country          @relation(fields: [destinationCountryId], references: [id])
  state                TransactionState @default(DRAFT)
  quantity             Int
  unitPrice            Decimal          @db.Decimal(18, 4)
  currency             String           @default("EUR")
  fxRateToEur          Decimal?         @db.Decimal(18, 8)
  subtotal             Decimal?         @db.Decimal(18, 4)
  commissionRate       Decimal?         @db.Decimal(7, 4)
  commissionAmount     Decimal?         @db.Decimal(18, 4)
  logisticsCost        Decimal?         @db.Decimal(18, 4)
  insuranceCost        Decimal?         @db.Decimal(18, 4)
  customsEstimate      Decimal?         @db.Decimal(18, 4)
  taxEstimate          Decimal?         @db.Decimal(18, 4)
  paymentFees          Decimal?         @db.Decimal(18, 4)
  buyerLandedCost      Decimal?         @db.Decimal(18, 4)
  sellerPayout         Decimal?         @db.Decimal(18, 4)
  platformRevenue      Decimal?         @db.Decimal(18, 4)
  eligibilitySnapshot  Json?
  isDemo               Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  items       TransactionItem[]
  stateEvents TransactionStateEvent[]
  reviews     ComplianceReview[]
  shipments   Shipment[]
  payments    Payment[]
  invoices    Invoice[]
  payouts     Payout[]
  permits     ImportPermit[]
  documents   Document[]
  messages    DealMessage[]

  @@index([sellerOrgId])
  @@index([buyerOrgId])
  @@index([state])
}

model TransactionItem {
  id            String      @id @default(uuid(7)) @db.Uuid
  transactionId String      @db.Uuid
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  batchId       String      @db.Uuid
  batch         Batch       @relation(fields: [batchId], references: [id])
  quantity      Int
  unitPrice     Decimal     @db.Decimal(18, 4)
  createdAt     DateTime    @default(now())

  @@index([transactionId])
}

model TransactionStateEvent {
  id            String            @id @default(uuid(7)) @db.Uuid
  transactionId String            @db.Uuid
  transaction   Transaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  fromState     TransactionState?
  toState       TransactionState
  actorType     ActorType
  actorUserId   String?           @db.Uuid
  reason        String?
  metadata      Json?
  createdAt     DateTime          @default(now())

  @@index([transactionId])
}

model ComplianceReview {
  id             String                 @id @default(uuid(7)) @db.Uuid
  type           ReviewType
  status         ReviewStatus           @default(PENDING)
  priority       Int                    @default(50)
  orgId          String?                @db.Uuid
  org            Organization?          @relation(fields: [orgId], references: [id])
  licenseId      String?                @db.Uuid
  license        License?               @relation(fields: [licenseId], references: [id])
  productId      String?                @db.Uuid
  product        Product?               @relation(fields: [productId], references: [id])
  listingId      String?                @db.Uuid
  listing        Listing?               @relation(fields: [listingId], references: [id])
  transactionId  String?                @db.Uuid
  transaction    Transaction?           @relation(fields: [transactionId], references: [id])
  ruleVersionId  String?                @db.Uuid
  ruleVersion    RegulatoryRuleVersion? @relation(fields: [ruleVersionId], references: [id])
  assignedToId   String?                @db.Uuid
  assignedTo     User?                  @relation("ReviewAssignee", fields: [assignedToId], references: [id])
  checklist      Json?
  decision       String?
  decisionReason String?
  decidedById    String?                @db.Uuid
  decidedBy      User?                  @relation("ReviewDecider", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([status, priority])
  @@index([type])
}

model ImportPermit {
  id            String       @id @default(uuid(7)) @db.Uuid
  buyerOrgId    String       @db.Uuid
  buyerOrg      Organization @relation(fields: [buyerOrgId], references: [id])
  countryId     String
  country       Country      @relation(fields: [countryId], references: [id])
  productId     String?      @db.Uuid
  transactionId String?      @db.Uuid
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  permitNumber  String
  issueDate     DateTime?
  expiryDate    DateTime?
  status        PermitStatus @default(PENDING)
  documentId    String?      @db.Uuid
  document      Document?    @relation(fields: [documentId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([buyerOrgId])
}

// ─────────────────── Documents, logistics, payments ───────────────────

model Document {
  id            String         @id @default(uuid(7)) @db.Uuid
  ownerOrgId    String         @db.Uuid
  ownerOrg      Organization   @relation(fields: [ownerOrgId], references: [id])
  type          String
  fileName      String
  mimeType      String
  sizeBytes     Int
  storageKey    String         @unique
  sha256        String
  status        DocumentStatus @default(UPLOADED)
  issuer        String?
  issueDate     DateTime?
  expiryDate    DateTime?
  countryId     String?
  country       Country?       @relation(fields: [countryId], references: [id])
  productId     String?        @db.Uuid
  product       Product?       @relation(fields: [productId], references: [id])
  batchId       String?        @db.Uuid
  batch         Batch?         @relation(fields: [batchId], references: [id])
  licenseId     String?        @db.Uuid
  license       License?       @relation(fields: [licenseId], references: [id])
  transactionId String?        @db.Uuid
  transaction   Transaction?   @relation(fields: [transactionId], references: [id])
  shipmentId    String?        @db.Uuid
  shipment      Shipment?      @relation(fields: [shipmentId], references: [id])
  uploadedById  String         @db.Uuid
  uploadedBy    User           @relation(fields: [uploadedById], references: [id])
  isDemo        Boolean        @default(false)
  createdAt     DateTime       @default(now())
  deletedAt     DateTime?

  permits  ImportPermit[]
  invoices Invoice[]

  @@index([ownerOrgId])
  @@index([batchId])
  @@index([licenseId])
  @@index([transactionId])
}

model Shipment {
  id                     String          @id @default(uuid(7)) @db.Uuid
  transactionId          String          @db.Uuid
  transaction            Transaction     @relation(fields: [transactionId], references: [id])
  originWarehouseId      String?         @db.Uuid
  originWarehouse        Warehouse?      @relation(fields: [originWarehouseId], references: [id])
  destinationAddress     String?
  destinationCity        String?
  destinationCountryId   String?
  carrier                String?
  service                String?
  incoterm               String?
  temperatureMode        TemperatureMode @default(AMBIENT)
  temperatureMonitoring  Boolean         @default(false)
  dangerousGoods         Boolean         @default(false)
  pickupDate             DateTime?
  estimatedArrival       DateTime?
  actualArrival          DateTime?
  trackingNumber         String?
  airwayBill             String?
  status                 ShipmentStatus  @default(PLANNED)
  customsStatus          String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  events          ShipmentEvent[]
  temperatureLogs TemperatureLog[]
  documents       Document[]

  @@index([transactionId])
}

model ShipmentEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  shipmentId String   @db.Uuid
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  type       String
  occurredAt DateTime
  location   String?
  data       Json?
  createdAt  DateTime @default(now())

  @@index([shipmentId])
}

model TemperatureLog {
  id           String   @id @default(uuid(7)) @db.Uuid
  shipmentId   String   @db.Uuid
  shipment     Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  recordedAt   DateTime
  temperatureC Decimal  @db.Decimal(6, 2)
  source       String?

  @@index([shipmentId])
}

model Payment {
  id            String       @id @default(uuid(7)) @db.Uuid
  transactionId String       @db.Uuid
  transaction   Transaction  @relation(fields: [transactionId], references: [id])
  provider      String
  providerRef   String?
  state         PaymentState @default(PENDING)
  amount        Decimal      @db.Decimal(18, 4)
  currency      String       @default("EUR")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([transactionId])
}

model Invoice {
  id            String      @id @default(uuid(7)) @db.Uuid
  transactionId String      @db.Uuid
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  number        String      @unique
  type          InvoiceType
  netAmount     Decimal     @db.Decimal(18, 4)
  taxAmount     Decimal     @db.Decimal(18, 4)
  grossAmount   Decimal     @db.Decimal(18, 4)
  currency      String      @default("EUR")
  issuedAt      DateTime
  documentId    String?     @db.Uuid
  document      Document?   @relation(fields: [documentId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([transactionId])
}

model Payout {
  id            String       @id @default(uuid(7)) @db.Uuid
  transactionId String       @db.Uuid
  transaction   Transaction  @relation(fields: [transactionId], references: [id])
  sellerOrgId   String       @db.Uuid
  sellerOrg     Organization @relation(fields: [sellerOrgId], references: [id])
  amount        Decimal      @db.Decimal(18, 4)
  currency      String       @default("EUR")
  state         PayoutState  @default(PENDING)
  executedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([transactionId])
}

model ExchangeRate {
  id        String   @id @default(uuid(7)) @db.Uuid
  base      String
  quote     String
  rate      Decimal  @db.Decimal(18, 8)
  source    String
  asOf      DateTime
  createdAt DateTime @default(now())

  @@index([base, quote, asOf])
}

model PricingReference {
  id         String          @id @default(uuid(7)) @db.Uuid
  productId  String          @db.Uuid
  product    Product         @relation(fields: [productId], references: [id])
  countryId  String?
  country    Country?        @relation(fields: [countryId], references: [id])
  priceType  String
  price      Decimal         @db.Decimal(18, 4)
  currency   String          @default("EUR")
  sourceName String
  sourceUrl  String?
  asOf       DateTime
  confidence ConfidenceLevel @default(UNVERIFIED)
  createdAt  DateTime        @default(now())

  @@index([productId])
}

// ───────────────────── Safety, audit, platform ─────────────────────

model SanctionsCheck {
  id          String               @id @default(uuid(7)) @db.Uuid
  subjectType SanctionsSubjectType
  subjectId   String
  provider    String               @default("MANUAL")
  result      SanctionsResult
  payload     Json?
  checkedById String?              @db.Uuid
  checkedBy   User?                @relation(fields: [checkedById], references: [id])
  checkedAt   DateTime             @default(now())
  expiresAt   DateTime?

  @@index([subjectType, subjectId])
}

model Recall {
  id             String           @id @default(uuid(7)) @db.Uuid
  productId      String?          @db.Uuid
  product        Product?         @relation(fields: [productId], references: [id])
  manufacturerId String?          @db.Uuid
  manufacturer   Manufacturer?    @relation(fields: [manufacturerId], references: [id])
  scope          String
  sourceName     String?
  sourceUrl      String?
  status         RecallCaseStatus @default(ACTIVE)
  issuedAt       DateTime
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  affectedBatches RecallAffectedBatch[]
}

model RecallAffectedBatch {
  id       String              @id @default(uuid(7)) @db.Uuid
  recallId String              @db.Uuid
  recall   Recall              @relation(fields: [recallId], references: [id], onDelete: Cascade)
  batchId  String              @db.Uuid
  batch    Batch               @relation(fields: [batchId], references: [id])
  status   AffectedBatchStatus @default(QUARANTINED)
  createdAt DateTime           @default(now())

  @@unique([recallId, batchId])
}

model AuditLog {
  id          String    @id @default(uuid(7)) @db.Uuid
  actorType   ActorType @default(USER)
  actorUserId String?   @db.Uuid
  actorUser   User?     @relation(fields: [actorUserId], references: [id])
  orgId       String?   @db.Uuid
  action      String
  entityType  String
  entityId    String?
  oldValue    Json?
  newValue    Json?
  reason      String?
  ip          String?
  sessionId   String?
  createdAt   DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([orgId])
  @@index([createdAt])
}

model Notification {
  id        String              @id @default(uuid(7)) @db.Uuid
  userId    String              @db.Uuid
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId     String?             @db.Uuid
  org       Organization?       @relation(fields: [orgId], references: [id])
  type      String
  title     String
  body      String?
  data      Json?
  channel   NotificationChannel @default(IN_APP)
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, readAt])
}

model DealMessage {
  id            String       @id @default(uuid(7)) @db.Uuid
  transactionId String       @db.Uuid
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  authorUserId  String       @db.Uuid
  authorUser    User         @relation(fields: [authorUserId], references: [id])
  orgId         String?      @db.Uuid
  org           Organization? @relation(fields: [orgId], references: [id])
  body          String
  createdAt     DateTime     @default(now())

  @@index([transactionId, createdAt])
}

model PlatformConfig {
  key         String   @id
  value       Json
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}
