# PharmaBridge environment configuration — copy to .env for local development.
# Validated at boot by src/lib/env.ts; the app fails fast on missing values.

# PostgreSQL (docker compose up -d → port 5547)
DATABASE_URL="postgresql://pharmabridge:pharmabridge_dev@localhost:5547/pharmabridge?schema=public"

# Public origin of the app (also used for CSRF origin checks)
APP_URL="http://localhost:3000"

# Document vault (local storage adapter; S3 adapter in staging/prod)
STORAGE_DIR="./var/storage"
MAX_UPLOAD_MB="25"

# E-mail — absent: console mailer (dev). Any SMTP provider (SES/Postmark/…):
# SMTP_URL="smtp://user:pass@smtp.example.eu:587"
# MAIL_FROM="PharmaBridge <no-reply@example.eu>"

# S3-compatible object storage — absent: local disk (dev)
# S3_ENDPOINT="https://s3.eu-central-1.example.com"
# S3_REGION="eu-central-1"
# S3_BUCKET="pharmabridge-documents"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Error tracking (prepared; account required — see PART L)
# SENTRY_DSN=""

# Production seed bootstrap (prisma/seed-production.ts only)
# SEED_ADMIN_EMAIL="admin@example.eu"
# SEED_ADMIN_PASSWORD=""
